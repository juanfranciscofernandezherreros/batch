      {
        "type": "table",
        "title": "Partidos pendientes",
        "description": "Clic en el matchId para abrir el partido en Flashscore. Cada columna se puede filtrar.",
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "fixtures-audit-http"
            },
            "type": "json",
            "source": "url",
            "format": "table",
            "url": "http://host.docker.internal:8090/fixtures-processing-audit/latest",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "parser": "backend",
            "root_selector": "($p := \"${pais:csv}\"; $c := \"${competicion:csv}\"; $m := pendingMatches[($p = \"'__all__'\" or country in $split($p, \",\")) and ($c = \"'__all__'\" or competition in $split($c, \",\"))]; $m.{\"fecha\": matchDate, \"pais\": country, \"competicion\": competition, \"matchId\": matchId, \"partido\": homeTeam & \" - \" & awayTeam, \"faltan\": $count(pendingDatasets), \"pendiente\": $join(pendingDatasets, \", \")})"
          }
        ],
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "fecha",
              "desc": true
            }
          ],
          "footer": {
            "show": true,
            "reducer": [
              "count"
            ],
            "fields": [
              "matchId"
            ],
            "countRows": true
          }
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "fecha": 0,
                "pais": 1,
                "competicion": 2,
                "matchId": 3,
                "partido": 4,
                "faltan": 5,
                "pendiente": 6
              },
              "renameByName": {
                "fecha": "Fecha",
                "pais": "Pais",
                "competicion": "Competicion",
                "partido": "Partido",
                "faltan": "Datasets que faltan",
                "pendiente": "Pendiente"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "filterable": true,
              "align": "auto"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "matchId"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
