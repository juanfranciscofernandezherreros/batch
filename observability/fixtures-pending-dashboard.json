      {
        "type": "stat",
        "title": "Estado",
        "description": "COMPLETED si la ultima auditoria termino bien.",
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "fixtures-audit-http"
            },
            "type": "json",
            "source": "url",
            "format": "table",
            "url": "http://host.docker.internal:8090/fixtures-processing-audit/latest",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "parser": "backend",
            "root_selector": "",
            "columns": [
              {
                "selector": "status",
                "text": "Estado",
                "type": "string"
              }
            ]
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "/.*/",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "COMPLETED": {
                    "text": "OK",
                    "color": "green",
                    "index": 0
                  }
                }
              },
              {
                "type": "special",
                "options": {
                  "match": "null+nan",
                  "result": {
                    "text": "SIN DATOS",
                    "color": "red",
                    "index": 1
                  }
                }
              },
              {
                "type": "regex",
                "options": {
                  "pattern": "^(?!COMPLETED$).*",
                  "result": {
                    "color": "red",
                    "index": 2
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "id": 1,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 4
        },
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
