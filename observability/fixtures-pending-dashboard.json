    "description": "Pendientes del modulo fixtures-processing-audit (GET :8090/fixtures-processing-audit/latest) via datasource Infinity fixtures-audit-http.",
    "links": [
      {
        "title": "JSON en vivo",
        "type": "link",
        "url": "http://localhost:8090/fixtures-processing-audit/latest",
        "targetBlank": true
      }
    ],
    "templating": {
      "list": [
        {
          "name": "pais",
          "label": "Pais",
          "type": "query",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-results"
          },
          "query": "SELECT country FROM fixtures.fixtures UNION SELECT country FROM results.results ORDER BY 1",
          "definition": "SELECT country FROM fixtures.fixtures UNION SELECT country FROM results.results ORDER BY 1",
          "multi": true,
          "includeAll": true,
          "allValue": "'__all__'",
          "refresh": 1,
          "sort": 1,
          "current": {
            "selected": true,
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          }
        },
        {
          "name": "competicion",
          "label": "Competicion",
          "type": "query",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-results"
