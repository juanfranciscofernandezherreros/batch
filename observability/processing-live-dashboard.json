      {
        "type": "stat",
        "id": 11,
        "title": "Extrayendo ahora",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres-results"
        },
        "description": "Pasos del orquestador de ligas (scripts\\ligas\\ORQUESTAR_LIGAS.ps1) en marcha: extraccion de Flashscore o importacion. Sale de public.pipeline_step.",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "postgres-results"
            },
            "rawQuery": true,
            "editorMode": "code",
            "format": "table",
            "rawSql": "SELECT count(*) AS en_curso FROM public.pipeline_step WHERE estado = 'RUNNING' AND started_at > now() - interval '12 hours' AND ('__all__' IN ($pais) OR pais IN ($pais)) AND ('__all__' IN ($competicion) OR competicion IN ($competicion))"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
                  "value": null
                },
                {
                  "color": "blue",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "type": "table",
        "id": 12,
        "title": "Orquestador: pasos en curso y recientes",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres-results"
        },
        "description": "Cada paso por liga (RESULTS extraer, RESULTS importar, POINT_BY_POINT extraer...). EN CURSO = se esta haciendo ahora; cubre tambien la extraccion, que no aparece en las tablas de importaciones hasta que hay CSV.",
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 20,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "postgres-results"
            },
            "rawQuery": true,
            "editorMode": "code",
            "format": "table",
            "rawSql": "SELECT estado, liga, paso, started_at AS empezado, finished_at AS terminado, round(extract(epoch FROM coalesce(finished_at, now()) - started_at)) AS segundos, detalle FROM public.pipeline_step WHERE ((estado = 'RUNNING' AND started_at > now() - interval '12 hours') OR started_at > now() - interval '24 hours') AND ('__all__' IN ($pais) OR pais IN ($pais)) AND ('__all__' IN ($competicion) OR competicion IN ($competicion)) ORDER BY (estado = 'RUNNING') DESC, started_at DESC LIMIT 50"
          }
        ],
        "options": {
          "showHeader": true,
          "cellHeight": "sm"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "filterable": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "estado"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "OK": {
                          "color": "green",
                          "index": 0
                        },
                        "FALLO": {
                          "color": "red",
                          "index": 1
                        },
                        "RUNNING": {
                          "color": "blue",
                          "index": 2,
                          "text": "EN CURSO"
                        },
                        "OMITIDO": {
                          "color": "yellow",
                          "index": 3
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "custom.width",
                  "value": 100
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "segundos"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "s"
                }
              ]
            }
          ]
        }
      },
