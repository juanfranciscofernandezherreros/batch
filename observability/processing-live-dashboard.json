            "rawSql": "SELECT status AS estado, batch_type AS tipo, regexp_replace(file_path, '^.*[/\\\\]', '') AS fichero, created_at AS encolado, started_at AS empezado, round(extract(epoch FROM now() - coalesce(started_at, created_at))) AS segundos FROM public.batch_launch_request WHERE request_id IN (SELECT request_id FROM public.v_csv_procesados WHERE ('__all__' IN ($pais) OR split_part(liga, '/', 1) IN ($pais)) AND ('__all__' IN ($competicion) OR split_part(liga, '/', 2) IN ($competicion))) AND status IN ('QUEUED','RUNNING') ORDER BY created_at"
